# Copy to .env and replace every placeholder before running.
PORT=3400
MONGODB_URL=mongodb://127.0.0.1:27017/tahator
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Generic SMS JSON endpoint; adapt payload in auth.service.js for your provider.
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=
# Development only: set true to print OTP locally when SMS_API_URL is not configured.
# Never enable this in production.
OTP_DEV_LOG=false
